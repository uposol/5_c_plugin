#!name = 5ch 阅读优化
#!desc = 裸 itest 帖子跳转 /l-；移除大写乱码、超过 5 次的重复正文及正文含 ◆ 的跟帖。清理列表及帖子广告和占位。需要 MitM。
#!author = uposol
#!homepage = https://github.com/uposol/5_c_plugin
#!loon_version = 3.5.2(1005)
#!tag = 网页优化,5ch
#!type = normal
# Adapted from supplied 5ch userscripts v1.0.0 and v1.8.0; 2026-10-02.

[Argument]
force_latest = switch,true,tag=跳转 l- 页面,desc=仅将 itest 裸帖子地址跳到 /l-，保留查询参数和已有范围
filter_spam = switch,true,tag=移除乱码和重复帖,desc=大写乱码及同页超过 5 次的相同正文整组移除
block_symbol = switch,true,tag=移除正文含 ◆ 的帖子,desc=沿用原脚本规则，只检查帖子正文

remove_ads = switch,true,tag=移除 5ch 广告,desc=清理列表插页、楼层广告和空白占位；仅针对 5ch

[Rewrite]
request if ${force_latest} == true && ${request.method} == "GET" && ${url} ~= /^https:\/\/itest\.5ch\.io(\/[^\/?#]+\/test\/read\.cgi\/[^\/?#]+\/[0-9]+)\/?((?:\?[^#]*)?)$/i as thread then redirect(302, "https://itest.5ch.io${thread.1}/l-${thread.2}")

request if ${remove_ads} == true && ${url} ~= /^https:\/\/itest\.5ch\.io\/(?:kn\/widget\?|ads\.json(?:\?|$)|assets\/(?:css\/ads\.css(?:\?|$)|js\/ad-manager-5ch\.js(?:\?|$)|img\/[^?#]*-300x250\.png(?:\?|$)))/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/(?:itest\.5ch\.io\/subback\/[^\/?#]+(?:\/[^?#]*)?|(?:itest\.5ch\.io\/[^\/?#]+|(?:[a-z0-9-]+\.)+5ch\.io)\/test\/read\.cgi\/[^\/?#]+\/[0-9]+(?:\/[^?#]*)?)(?:\?[^#]*)?$/i && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^text\/html(?:\s*;|$)/i && (${filter_spam} == true || ${block_symbol} == true || ${remove_ads} == true) then script("https://raw.githubusercontent.com/uposol/5_c_plugin/main/5ch_Reading.response.js", {${force_latest}, ${filter_spam}, ${block_symbol}, ${remove_ads}}) with tag="5ch 阅读优化", timeout=10, requires_body=true

[Mitm]
hostname = itest.5ch.io,*.5ch.io
